# Paste into Vercel: Project > Settings > Environment Variables (the import box accepts this format).
# Fill in APP_KEY and DATABASE_URL; everything else can stay as is.
# DATABASE_URL: use Neon's direct connection string (Connection pooling OFF, no "-pooler" in the host).
# The pooler runs PgBouncer in transaction mode, which loses PDO's server-side prepared statements.

APP_ENV=production
APP_DEBUG=false
APP_KEY=
DATABASE_URL=

DB_CONNECTION=pgsql
CACHE_DRIVER=database
SESSION_DRIVER=cookie
LOG_CHANNEL=stderr
DEMO_RESET_HOURS=3

# The serverless filesystem is read-only except /tmp.
APP_CONFIG_CACHE=/tmp/config.php
APP_EVENTS_CACHE=/tmp/events.php
APP_PACKAGES_CACHE=/tmp/packages.php
APP_ROUTES_CACHE=/tmp/routes.php
APP_SERVICES_CACHE=/tmp/services.php
VIEW_COMPILED_PATH=/tmp
